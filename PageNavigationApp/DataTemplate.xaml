<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PageNavigationApp.ViewModels"
                    xmlns:view="clr-namespace:PageNavigationApp.Views">


    <DataTemplate DataType="{x:Type TypeName=vm:HomeViewModel}">
        <view:HomeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TypeName=vm:CustomersViewModel}">
        <view:CustomersView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TypeName=vm:ProductsViewModel}">
        <view:ProductsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TypeName=vm:OrdersViewModel}">
        <view:OrdersView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TypeName=vm:TransactionsViewModel}">
        <view:TransactionsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TypeName=vm:ShipmentsViewModel}">
        <view:ShipmentsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TypeName=vm:SettingsViewModel}">
        <view:SettingsView />
    </DataTemplate>

</ResourceDictionary>