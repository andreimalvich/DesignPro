<Window x:Class="PageNavigationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PageNavigationApp"
        xmlns:vm="clr-namespace:PageNavigationApp.ViewModels"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:PageNavigationApp.Controls"
        Title="MainWindow" Height="600" Width="850"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        >

    
    <Window.DataContext>
        <vm:NavigationViewModel />
    </Window.DataContext>
    


    <Grid>

        <!--// Window Border //-->
        <Border Background="#212529"
                CornerRadius="20"/>
        <Grid>

            <!--// Base Grid //-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="622"/>
            </Grid.ColumnDefinitions>

            <!--// Navigation Panel //-->
            <Grid HorizontalAlignment="Left"
                  Width="228">

                <Border Background="#272B2F"
                        CornerRadius="20,0,0,20" />

                <StackPanel Height="400"
                            Width="228">

                    <!--// Home //-->
                    <controls:Btn Style="{StaticResource BtnStyle}"
                                  IsChecked="True"
                                  Command="{Binding GoToHomeCommand}">
                        <Grid>
                            <Image Source="/Assets/Images/img_home.png"
                                   Style="{StaticResource Image_Style}"/>
                            <TextBlock Style="{StaticResource Text_Style}"
                                       Text="Home"/>
                        </Grid>
                    </controls:Btn>

                    <!--// Customer //-->
                    <controls:Btn Style="{StaticResource BtnStyle}"
                                  Command="{Binding GoToCustomersCommand}">
                        <Grid>
                            <Image Source="/Assets/Images/img_customer.png"
                                   Style="{StaticResource Image_Style}"/>
                            <TextBlock Style="{StaticResource Text_Style}"
                                       Text="Customer"/>
                        </Grid>
                    </controls:Btn>

                    <!--// Products //-->
                    <controls:Btn Style="{StaticResource BtnStyle}"
                                  Command="{Binding GoToProductsCommand}">
                        <Grid>
                            <Image Source="/Assets/Images/img_product.png"
                                   Style="{StaticResource Image_Style}"/>
                            <TextBlock Style="{StaticResource Text_Style}"
                                       Text="Products"/>
                        </Grid>
                    </controls:Btn>
                    
                    <!--// Orders //-->
                    <controls:Btn Style="{StaticResource BtnStyle}"
                                  Command="{Binding GoToOrdersCommand}">
                        <Grid>
                            <Image Source="/Assets/Images/img_order.png"
                                   Style="{StaticResource Image_Style}"/>
                            <TextBlock Style="{StaticResource Text_Style}"
                                       Text="Orders"/>
                        </Grid>
                    </controls:Btn>

                    <!--// Transactions //-->
                    <controls:Btn Style="{StaticResource BtnStyle}"
                                  Command="{Binding GoToTransactionsCommand}">
                        <Grid>
                            <Image Source="/Assets/Images/img_transaction.png"
                                   Style="{StaticResource Image_Style}"/>
                            <TextBlock Style="{StaticResource Text_Style}"
                                       Text="Transactions"/>
                        </Grid>
                    </controls:Btn>

                    <!--// Shipments //-->
                    <controls:Btn Style="{StaticResource BtnStyle}"
                                  Command="{Binding GoToShipmentsCommand}">
                        <Grid>
                            <Image Source="/Assets/Images/img_shipment.png"
                                   Style="{StaticResource Image_Style}"/>
                            <TextBlock Style="{StaticResource Text_Style}"
                                       Text="Shipments"/>
                        </Grid>
                    </controls:Btn>

                    <!--// Settings //-->
                    <controls:Btn Style="{StaticResource BtnStyle}"
                                  Command="{Binding GoToSettingsCommand}">
                        <Grid>
                            <Image Source="/Assets/Images/img_setting.png"
                                   Style="{StaticResource Image_Style}"/>
                            <TextBlock Style="{StaticResource Text_Style}"
                                       Text="Settings"/>
                        </Grid>
                    </controls:Btn>
                </StackPanel>


            </Grid>

            <Grid Grid.Column="1">
                <ContentControl x:Name="Pages" 
                                Content="{Binding CurrentView}"/>

            </Grid>
        </Grid>

        <Button x:Name="CloseApp"
                Click="CloseApp_Click"
                Style="{StaticResource ExitApp}"/>


    </Grid>
</Window>
